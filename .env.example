# MAI - Music Audience Insights
# Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in the actual values from your API accounts
# 3. NEVER commit .env to git (it's in .gitignore)
# 4. Keep .env.example updated when adding new variables

# ═════════════════════════════════════════════════════════════
# SPOTIFY API  (required)
# Get credentials at: https://developer.spotify.com/dashboard
# ═════════════════════════════════════════════════════════════
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here

# ═════════════════════════════════════════════════════════════
# YOUTUBE API  (required)
# Get API key at: https://console.cloud.google.com
# Enable: YouTube Data API v3
# ═════════════════════════════════════════════════════════════
YOUTUBE_API_KEY=your_youtube_api_key_here

# ═════════════════════════════════════════════════════════════
# LAST.FM API  (optional — enables the Last.fm section)
# Get API key at: https://www.last.fm/api/account/create
# ═════════════════════════════════════════════════════════════
LASTFM_API_KEY=your_lastfm_api_key_here

# ═════════════════════════════════════════════════════════════
# RAPIDAPI  (optional — enables TikTok integration)
# Get API key at: https://rapidapi.com/
# Current integration: tiktok-scraper7
# ═════════════════════════════════════════════════════════════
# RAPIDAPI_KEY=your_rapidapi_key_here

# ═════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═════════════════════════════════════════════════════════════
FLASK_ENV=production
FLASK_DEBUG=False
HOST=0.0.0.0
PORT=5000
